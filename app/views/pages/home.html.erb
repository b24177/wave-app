<div class="home-cover">
  <div class="home-backdrop"></div>
  <div class="home-shell text-center">
    <div class="home-brand">
      <%= render 'shared/animated_logo' %>
      <h1 class="home-title">Your Music World, In One Feed</h1>
      <p class="home-subtitle">Track releases, videos, and tour moments from every artist you care about.</p>
    </div>
  </div>
  <div class="btns-home">
    <%= link_to 'CREATE ACCOUNT', new_user_registration_path, class: 'btn-signup home-primary-btn' %>
    <%= button_to 'LOG IN WITH SPOTIFY',
      user_spotify_omniauth_authorize_path,
      method: :post,
      form: { data: { turbo: false } },
      form_class: 'home-spotify-form',
      class: 'home-auth-btn' %>
    <%= link_to 'LOG IN WITH EMAIL', new_user_session_path, class: 'home-auth-btn' %>
  </div>
</div>
