<section class="artists-page">
  <header class="artists-page-header">
    <h1>Artists</h1>
    <p class="artists-page-subtitle">Your followed artists in one place.</p>
  </header>

  <%= form_with url: artists_path, method: :get, local: true, class: 'artists-search' do |form| %>
    <div class="artists-search-row">
      <%= form.text_field :query, value: @query, placeholder: 'Search followed artists', class: 'form-control artists-search-input' %>
      <%= form.submit 'Search', class: 'btn artists-search-submit artists-btn-primary' %>
      <% if @query.present? %>
        <%= link_to 'Clear', artists_path, class: 'btn artists-search-clear artists-btn-secondary' %>
      <% end %>
    </div>
  <% end %>

  <div class="cards artists-cards">
    <% unless @artists.empty? %>
      <% @artists.each do |artist| %>
        <%= render 'shared/artist_card', artist: artist %>
      <% end %>

      <div class="artists-pagination">
        <div class="artists-pagination-side">
          <% if @has_previous_page %>
            <%= link_to 'Previous', artists_path(page: @current_page - 1, query: @query.presence), class: 'btn artists-btn-secondary artists-page-nav-btn' %>
          <% end %>
        </div>

        <span class="artists-pagination-meta">Page <%= @current_page %> of <%= @total_pages %></span>

        <div class="artists-pagination-side artists-pagination-side-right">
          <% if @has_next_page %>
            <%= link_to 'Next', artists_path(page: @current_page + 1, query: @query.presence), class: 'btn artists-btn-secondary artists-page-nav-btn' %>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="artists-empty-state">
        <% if @query.present? %>
          <p>No followed artists match "<%= @query %>".</p>
        <% else %>
          <p>Start following your favorite artists now.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
