<div class="header">
  <div class="header-logo">
    <%= render 'shared/logo' %>
  </div>
  <div class="header-user-avatar">
    <%= link_to profile_path, aria: { label: 'Profile' } do %>
      <span class="header-user-avatar-placeholder" aria-hidden="true">
        <i class="fa-regular fa-user"></i>
      </span>
    <% end %>
  </div>
</div>
