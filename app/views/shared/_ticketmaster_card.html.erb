<% content_map = post.contents.index_by(&:format) %>
<% event_name = content_map['event_name']&.data %>
<% venue = content_map['venue']&.data %>
<% city = content_map['city']&.data %>
<% starts_at = content_map['starts_at']&.data %>
<% ticket_url = content_map['ticket_url']&.data %>
<% image_url = content_map['image_url']&.data %>

<div class="universal-card feed-card ticketmaster-card">
  <div class="post-title">
    <%= render 'shared/artist_avatar', artist: post.artist %>
    <div class="post-meta">
      <h3 class="post-heading">
        <span class="artist-name"><%= post.artist.name %></span>
        <span class="source-chip source-ticketmaster"><%= post.source %></span>
      </h3>
      <% if event_name.present? %>
        <p class="ticketmaster-event-name"><%= event_name %></p>
      <% end %>
      <% if starts_at.present? %>
        <% parsed_time = Time.zone.parse(starts_at) rescue nil %>
        <p class="ticketmaster-meta-line"><%= parsed_time ? parsed_time.strftime('%b %-d, %Y %l:%M %p') : starts_at %></p>
      <% end %>
      <% if venue.present? || city.present? %>
        <p class="ticketmaster-meta-line"><%= [venue, city].compact.join(' • ') %></p>
      <% end %>
    </div>
  </div>

  <% if image_url.present? %>
    <img src="<%= image_url %>" class="universal-image" alt="Ticketmaster event image">
  <% end %>

  <div class="ticketmaster-footer">
    <% if ticket_url.present? %>
      <div class="ticketmaster-cta">
        <%= link_to 'VIEW TICKETS', ticket_url, target: '_blank', rel: 'noopener noreferrer', class: 'btn-buy-tickets' %>
      </div>
    <% end %>

    <div class="card-share ticketmaster-share">
      <button type="button" class="card-action" aria-label="Repost">
        <i class="fa-solid fa-retweet" aria-hidden="true"></i>
      </button>
      <button type="button" class="card-action" aria-label="Like">
        <i class="fa-regular fa-heart" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</div>
